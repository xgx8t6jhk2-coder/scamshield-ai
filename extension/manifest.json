{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "description": "__MSG_description__",
  "version": "1.0.0",
  "default_locale": "en",
  "icons": {"16": "icons/shield-16.png", "32": "icons/shield-32.png", "48": "icons/shield-48.png", "128": "icons/shield-128.png"},
  "action": {
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/shield-16.png", "32": "icons/shield-32.png"}
  },
  "background": {"service_worker": "background.js", "type": "module"},
  "permissions": ["webNavigation", "tabs", "storage", "contextMenus"],
  "host_permissions": ["https://scamshield-ai-eaj.pages.dev/*"],
  "content_scripts": [{
    "matches": ["https://mail.google.com/*", "https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*", "https://outlook.cloud.microsoft/*", "https://web.whatsapp.com/*"],
    "js": ["hover.js"],
    "css": ["hover.css"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["check.js", "engine/scamshield.js"],
    "matches": ["https://mail.google.com/*", "https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*", "https://outlook.cloud.microsoft/*", "https://web.whatsapp.com/*"]
  }]
}
